<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.zeroc.home">

    <!-- API 30+ прячет список приложений без этого разрешения -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- переключатель «Не беспокоить» в «Быстром управлении» -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- слайдер громкости -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <uses-sdk android:minSdkVersion="22" android:targetSdkVersion="33" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:supportsRtl="false"
        android:theme="@style/ZerOS">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden">

            <!-- домашний экран -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- чтобы приложение было видно в списке, пока оно не назначено домашним -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
