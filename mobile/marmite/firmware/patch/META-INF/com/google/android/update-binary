#!/sbin/sh
#
# ZerOS I 1.0 - branding patch for Wileyfox Swift 2 (marmite).
# Writes branding files directly into the real system partition.
# No Magisk, no modules: everything ends up in /system.
#
# Zip layout:
#   system/...        files exactly as they must appear in /system
#   md5sums.txt       checksums of the payload (system/... paths)
#   META-INF/...      this script
#
# The system partition root on marmite is mounted at / by Android and its
# files live in /<root>/system. TWRP may mount it at /system or
# /system_root, so the script mounts the block device itself and looks for
# the directory that actually contains build.prop and product/overlay.

OUTFD="$2"
ZIPFILE="$3"

ui_print() {
  echo "ui_print $1" >&"$OUTFD"
  echo "ui_print" >&"$OUTFD"
}

die() {
  ui_print " "
  ui_print "ERROR: $1"
  ui_print "Patch stopped."
  exit 1
}

ui_print "ZerOS I 1.0 - Wileyfox Swift 2 (marmite)"
ui_print "Branding patch: files are written into /system"
ui_print " "

TMP=${ZEROTMP:-/tmp/zeropatch}
rm -rf "$TMP"
mkdir -p "$TMP" || die "cannot create $TMP"

ui_print "Unpacking payload..."
( cd "$TMP" && unzip -o "$ZIPFILE" >/dev/null 2>&1 ) || die "unzip failed"
[ -f "$TMP/system/build.prop" ] || die "payload has no system/build.prop"

if [ -f "$TMP/md5sums.txt" ]; then
  ( cd "$TMP" && md5sum -c md5sums.txt >/dev/null 2>&1 ) || die "payload is damaged (md5 mismatch)"
fi

PART=/dev/block/bootdevice/by-name/system
[ -e "$PART" ] || PART=/dev/block/platform/soc/7824900.sdhci/by-name/system
[ -e "$PART" ] || die "system partition not found"

mkdir -p /mnt/zerosys
grep -q " /mnt/zerosys " /proc/mounts || mount -o rw "$PART" /mnt/zerosys 2>/dev/null

SYS=""
for cand in /mnt/zerosys/system /system_root/system /system/system /system; do
  if [ -f "$cand/build.prop" ] && [ -d "$cand/product/overlay" ]; then
    SYS="$cand"
    break
  fi
done

if [ -z "$SYS" ]; then
  mount -o rw,remount /system 2>/dev/null
  mount -o rw,remount /system_root 2>/dev/null
  mount -o rw,remount / 2>/dev/null
  for cand in /system_root/system /system/system /system; do
    if [ -f "$cand/build.prop" ] && [ -d "$cand/product/overlay" ]; then
      SYS="$cand"
      break
    fi
  done
fi

[ -n "$SYS" ] || die "cannot find a mounted system partition"
ui_print "System: $SYS"

touch "$SYS/.zerotest" 2>/dev/null || {
  mount -o rw,remount "$SYS" 2>/dev/null
  mount -o rw,remount "$(dirname "$SYS")" 2>/dev/null
  mount -o rw,remount /system 2>/dev/null
  mount -o rw,remount /system_root 2>/dev/null
  mount -o rw,remount / 2>/dev/null
  touch "$SYS/.zerotest" 2>/dev/null
}
[ -f "$SYS/.zerotest" ] || die "system is not writable"
rm -f "$SYS/.zerotest"

BAK="/sdcard/zerobak-patch-$(date +%Y%m%d-%H%M%S)"
mkdir -p "$BAK"
ui_print "Backup of replaced files: $BAK"
for f in build.prop media/bootanimation.zip product/priv-app/Settings/Settings.apk priv-app/Updater/Updater.apk; do
  if [ -f "$SYS/$f" ]; then
    cp -f "$SYS/$f" "$BAK/$(basename "$f")"
  fi
done

ui_print "Copying files..."
for f in build.prop \
         media/bootanimation.zip \
         product/overlay/ZerOSAccent.apk \
         product/overlay/ZerOSFont.apk \
         product/overlay/ZerOSShape.apk \
         product/overlay/ZerOSLogo.apk \
         product/priv-app/Settings/Settings.apk \
         priv-app/Updater/Updater.apk \
         priv-app/ZerOSAbout/ZerOSAbout.apk; do
  mkdir -p "$SYS/$(dirname "$f")"
  cp -f "$TMP/system/$f" "$SYS/$f" || die "copy failed: $f"
  case "$f" in
    build.prop) chmod 600 "$SYS/$f" ;;
    *)          chmod 644 "$SYS/$f" ;;
  esac
  chown 0:0 "$SYS/$f" 2>/dev/null
  case "$f" in
    product/overlay/*) CTX=u:object_r:vendor_overlay_file:s0 ;;
    *)                 CTX=u:object_r:system_file:s0 ;;
  esac
  command -v chcon >/dev/null 2>&1 && chcon "$CTX" "$SYS/$f" 2>/dev/null

  # Android caches the parsed package of a system app in
  # /data/system/package_cache and treats the entry as valid while the app
  # directory's mtime is not newer than the cache file. Overwriting a file in
  # place keeps the directory mtime, so the stale entry (with the old app's
  # resources) would be reused and the app would crash on first boot. Refresh
  # the directory mtime and drop the matching cache entry.
  appdir=$(dirname "$f")
  touch "$SYS/$appdir" 2>/dev/null
  rm -f "/data/system/package_cache/$(basename "$appdir")-"* 2>/dev/null

  ui_print "  $f"
done

ui_print "Verifying..."
ok=1
if [ -f "$TMP/md5sums.txt" ]; then
  while read -r sum path; do
    t="$SYS/${path#system/}"
    got=$(md5sum "$t" 2>/dev/null | cut -d' ' -f1)
    [ "$got" = "$sum" ] || ok=0
  done < "$TMP/md5sums.txt"
fi
[ "$ok" = "1" ] || die "written files do not match the payload"

sync
umount /mnt/zerosys 2>/dev/null
rm -rf "$TMP"

ui_print " "
ui_print "Done. Reboot to system."
ui_print "Version: Settings - About phone - ZerOS version 1.0"
