<?xml version="1.0" encoding="utf-8"?>
<!-- Шрифт темы "Silly": Rubik, как у org.lineageos.overlay.font.rubik.
     Самих TTF в оверлее нет - семейства rubik/rubik-medium лежат в системе
     (/system/etc/fonts.xml), оверлей только выбирает их по умолчанию. -->
<resources>
