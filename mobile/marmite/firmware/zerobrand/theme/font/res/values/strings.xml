    <string name="config_bodyFontFamilyMedium">rubik-medium</string>
    <string name="config_headlineFontFamily">rubik</string>
    <string name="config_headlineFontFamilyMedium">rubik-medium</string>
    <string name="zeroc_font_label">ZerOS Rubik</string>
</resources>
