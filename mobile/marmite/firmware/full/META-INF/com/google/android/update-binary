#!/sbin/sh
#
# ZerOS I 1.0 - Wileyfox Swift 2 (marmite).
# Full ROM install for TWRP: boot, vendor and system are written from images.
#
# Zip layout:
#   md5sums.txt       md5 of every image (name matches the partition)
#   boot.img          raw image for the boot partition
#   vendor.img        raw image for the vendor partition
#   system.img        raw image for the system partition
#   README.txt        Russian description
#   META-INF/...      this script
#
# Each image is streamed straight to its block device, then the partition is
# read back and checked against md5sums.txt. After that the package/resource
# caches of Android 10 are dropped: they are considered valid by directory
# mtime, and a system replaced under the same paths would otherwise reuse
# stale parsed packages.

OUTFD="$2"
ZIPFILE="$3"

ui_print() {
  echo "ui_print $1" >&"$OUTFD"
  echo "ui_print" >&"$OUTFD"
}

die() {
  ui_print " "
  ui_print "ERROR: $1"
  ui_print "Install stopped."
  exit 1
}

part_of() {
  case "$1" in
    boot)   PART=/dev/block/bootdevice/by-name/boot ;;
    system) PART=/dev/block/bootdevice/by-name/system ;;
    vendor)
      # marmite has no "vendor" entry in by-name: the partition is
      # /dev/block/mmcblk0p30 (256 MiB, squashfs) and Android mounts it
      # by device number.
      if [ -e /dev/block/bootdevice/by-name/vendor ]; then
        PART=/dev/block/bootdevice/by-name/vendor
      elif [ -e /dev/block/platform/soc/7824900.sdhci/by-name/vendor ]; then
        PART=/dev/block/platform/soc/7824900.sdhci/by-name/vendor
      else
        PART=/dev/block/mmcblk0p30
      fi
      ;;
  esac
  [ -e "$PART" ]
}

image_size() {
  unzip -l "$ZIPFILE" | awk -v f="$1" '$NF == f { print $1; exit }'
}

ui_print "ZerOS I 1.0 - Wileyfox Swift 2 (marmite)"
ui_print "Full install: boot, vendor, system"
ui_print " "

TMP=/tmp/zerofull
rm -rf "$TMP"
mkdir -p "$TMP" || die "cannot create $TMP"
unzip -p "$ZIPFILE" md5sums.txt > "$TMP/md5sums.txt" 2>/dev/null
[ -s "$TMP/md5sums.txt" ] || die "archive has no md5sums.txt"

ui_print "Unmounting partitions..."
umount /system 2>/dev/null
umount /system_root 2>/dev/null
umount /vendor 2>/dev/null
umount /mnt/vendor 2>/dev/null
umount /mnt/zerosys 2>/dev/null

for img in boot.img vendor.img system.img; do
  name=${img%.img}
  part_of "$name" || die "$name partition not found"

  SIZE=$(image_size "$img")
  [ -n "$SIZE" ] || die "$img not found in the archive"
  SUM=$(awk -v f="$img" '$2 == f { print $1; exit }' "$TMP/md5sums.txt")
  [ -n "$SUM" ] || die "$img has no md5 in md5sums.txt"

  ui_print "Writing $name ($SIZE bytes)..."
  unzip -p "$ZIPFILE" "$img" | dd of="$PART" bs=4194304 2>/dev/null
  [ $? -eq 0 ] || die "writing $img failed"
  sync

  ui_print "Verifying $name..."
  GOT=$(head -c "$SIZE" "$PART" | md5sum | cut -d' ' -f1)
  [ "$GOT" = "$SUM" ] || die "$img does not match (md5 $GOT)"
  sync
done

ui_print "Clearing package and resource caches..."
if [ -d /data/system/package_cache ]; then
  rm -rf /data/system/package_cache/* 2>/dev/null
fi
if [ -d /data/resource-cache ]; then
  rm -rf /data/resource-cache/* 2>/dev/null
fi

rm -rf "$TMP"

ui_print " "
ui_print "Done. Reboot to system (first boot 2-5 minutes)."
ui_print "Check: Settings - About phone - ZerOS version 1.0"
